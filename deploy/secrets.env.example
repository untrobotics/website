# Copy to deploy/secrets.env (gitignored) and fill in real values, then run
# deploy/deploy.sh. Only the keys you set are created; anything omitted is left
# blank, which config.docker.php treats as "integration disabled".

# Database (DATABASE_PASSWORD and MYSQL_PASSWORD must match)
DATABASE_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Core app
HASH_SALT=
API_SECRET=

# Third-party (optional; fill only what you test)
SENDGRID_API_KEY=
PRINTFUL_API_KEY=
GOOGLE_RECAPTCHA_KEY=
DISCORD_CLIENT_PUBLIC_KEY=
DISCORD_ADMIN_BOT_TOKEN=
GROUPME_ACCESS_TOKEN=
PAYPAL_BUSINESS_ID=
PAYPAL_API_ACCOUNT=
PAYPAL_API_PASSWORD=
PAYPAL_API_SIGNATURE=
