# UNT Robotics Discord bot — local dev configuration.
# Copy to .env (gitignored) and fill in. In k8s these come from the
# web-config ConfigMap + web-secrets Secret (envFrom) plus discord-bot.yaml.

# --- Discord identity (required) ---
# Reuse the existing admin bot token. Either name works (DISCORD_ADMIN_BOT_TOKEN
# is the app's existing var); DISCORD_BOT_TOKEN takes precedence if both set.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=639209564188704768

# --- Verification targets (required) ---
DISCORD_VERIFIED_ROLE_ID=
DISCORD_VERIFY_CHANNEL_ID=
# Audit log channel (defaults to the admin channel used by the PHP bot).
DISCORD_LOG_CHANNEL_ID=674703370971250708

# --- Email verification ---
ALLOWED_EMAIL_DOMAINS=unt.edu,my.unt.edu,untsystem.edu,untdallas.edu,unthsc.edu
SENDGRID_API_KEY=
EMAIL_FROM=verify@untrobotics.com
EMAIL_FROM_NAME=UNT Robotics

# --- Database (required: password) ---
# DB_* are accepted; the app's DATABASE_* names are accepted as fall-backs.
DB_HOST=mysql
DB_USER=untrobotics-web
DB_PASSWORD=
DB_NAME=untrobotics

# --- Verification tunables (defaults shown) ---
CODE_LENGTH=6
CODE_TTL_SECONDS=600
MAX_VERIFY_PER_HOUR=5
VERIFY_COOLDOWN_SECONDS=60
MAX_TOKEN_ATTEMPTS=5
TOKEN_ATTEMPT_COOLDOWN_SECONDS=5
LOCKOUT_THRESHOLD=10
LOCKOUT_SECONDS=3600

# Optional: secret mixed into the code hash (falls back to HASH_SALT).
# VERIFY_HASH_SECRET=

# Optional: enable verbose debug logging.
# DEBUG=1
