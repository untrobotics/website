# Copy to .env for the local docker-compose stack:  cp .env.example .env
#
# These are LOCAL-DEV values. Real secrets belong in a Kubernetes Secret for
# deployment, never committed. Leave third-party keys blank unless you are
# testing that specific integration.

# --- Database (must match docker-compose mysql service) ----------------------
DATABASE_HOST=mysql
DATABASE_NAME=untrobotics
DATABASE_USER=untrobotics-web
DATABASE_PASSWORD=untrobotics
DATABASE_CHARSET=latin1

# --- App ---------------------------------------------------------------------
APP_ENV=development
WEBSITE_URL=http://localhost:8080
WEBSITE_DOMAIN=localhost
HASH_SALT=local-dev-salt-change-me
API_SECRET=local-dev-api-secret

# --- Third-party integrations (blank = disabled locally) ---------------------
SENDGRID_API_KEY=
PRINTFUL_API_KEY=
GOOGLE_RECAPTCHA_KEY=
GOOGLE_CLIENT_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FIND_FIRST_QUEUE_SID=

DISCORD_CLIENT_PUBLIC_KEY=
DISCORD_ADMIN_BOT_TOKEN=
DISCORD_APP_CLIENT_ID=
DISCORD_APP_CLIENT_SECRET=


PAYPAL_BUSINESS_ID=
PAYPAL_PDT_ID_TOKEN=
PAYPAL_API_ACCOUNT=
PAYPAL_API_PASSWORD=
PAYPAL_API_SIGNATURE=
PAYPAL_SANDBOX_BUSINESS_ID=
PAYPAL_SANDBOX_PDT_ID_TOKEN=

NAMECOM_API_USERNAME=
NAMECOM_API_KEY=
